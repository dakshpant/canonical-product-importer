generator client {
    provider     = "prisma-client"
    output       = "../generated/prisma"
    moduleFormat = "esm"
}

datasource db {
    provider = "sqlite"
}

// Field names follow the canonical product schema exactly (snake_case),
// so records map one-to-one onto the marketplace model.

// Product Model

model Product {
    // Identity
    id           String  @id @default(cuid())
    name         String
    sku_id       String? @unique
    slug         String  @unique
    product_kind String?

    // Categorization
    category     String?
    industry     String?
    sub_category String?

    // Description
    tagline           String?
    short_description String?
    overview          String?

    // Product details
    website         String?
    unit_of_measure String?
    min_quantity    Float?
    max_quantity    Float?

    // Image information
    image_url         String?
    image_alt         String?
    image_type        String?
    image_source_page String?

    // Collections
    tags             Json?
    skills           Json?
    features         Json?
    deployments      Json?
    platforms        Json?
    target_customers Json?

    // Approval lifecycle
    status String @default("DRAFT")

    // Timestamps
    created_at       DateTime                @default(now())
    updated_at       DateTime                @updatedAt
    import_records   ImportRecord[]
    update_proposals ProductUpdateProposal[]
    sources          ProductSource[]

    @@index([status])
    @@index([category])
}

//Import Batch and Record Models
model ImportBatch {
    id     String @id @default(cuid())
    status String @default("PENDING")

    total_urls     Int
    completed_urls Int @default(0)
    failed_urls    Int @default(0)

    records ImportRecord[]

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@index([status])
}

model ImportRecord {
    id     String @id @default(cuid())
    url    String
    status String @default("PENDING")

    extracted_data Json?
    error_message  String?
    attempts       Int     @default(0)

    batch_id String
    batch    ImportBatch @relation(fields: [batch_id], references: [id], onDelete: Cascade)

    product_id String?
    product    Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)

    created_at      DateTime               @default(now())
    updated_at      DateTime               @updatedAt
    update_proposal ProductUpdateProposal?
    sources         ProductSource[]

    @@index([batch_id])
    @@index([status])
    @@index([product_id])
}

model ProductUpdateProposal {
    id String @id @default(cuid())

    // Existing product being refreshed
    product_id String
    product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

    // Import that generated this proposal
    import_record_id String       @unique
    import_record    ImportRecord @relation(fields: [import_record_id], references: [id], onDelete: Cascade)

    // Newly extracted product information
    proposed_data Json

    // Field-level review decisions
    reviewed_fields Json?

    // Overall review status
    status      String    @default("PENDING")
    reviewed_at DateTime?

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@index([product_id])
    @@index([status])
}

model ProductSource {
    id String @id @default(cuid())

    // The product this evidence supports (optional initially)
    product_id String?
    product    Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)

    // The import attempt that collected this evidence
    import_record_id String
    import_record    ImportRecord @relation(fields: [import_record_id], references: [id], onDelete: Cascade)

    // Which canonical field does this evidence support?
    field_name String

    // Exact extracted value, supporting strings, arrays, or objects
    extracted_value Json?

    // Supporting text from the original webpage
    evidence_text String?

    // How the information was found
    source_type String?

    // Actual URL where the evidence was found
    source_url String

    created_at DateTime @default(now())

    @@index([product_id])
    @@index([import_record_id])
    @@index([field_name])
}
