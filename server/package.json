{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "postinstall": "prisma generate --config prisma7.config.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "db:migrate:dev": "prisma migrate dev --config prisma7.config.ts",
    "db:status": "prisma migrate status --config prisma7.config.ts",
    "db:reset": "prisma migrate reset --config prisma7.config.ts",
    "setup": "node -e \"require('fs').existsSync('.env')||require('fs').copyFileSync('.env.example','.env')\" && npm run db:migrate",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test src/test-ai-extraction.js src/test-proposal-review.js src/test-product-update.js src/test-recorded-client.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "ipaddr.js": "^2.5.0",
    "robots-parser": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^7.10.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
