DATABASE_URL="file:./dev.db"
# The Vite dev server proxies /api to http://localhost:5001 (5000 is taken by AirPlay on macOS)
PORT=5001
NODE_ENV=development

# Groq (free tier) for live extraction: https://console.groq.com
# Optional: without a key the app replays recorded responses (see LLM_MODE).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# How the AI step gets its answer:
#   auto   - key set: live Groq; no key: replay server/recordings/ (default)
#   live   - always live Groq
#   record - live Groq, and save each answer to server/recordings/
#   replay - always replay recordings, never call Groq
LLM_MODE=auto
