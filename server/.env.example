DATABASE_URL="file:./dev.db"
# The Vite dev server proxies /api to http://localhost:5001 (5000 is taken by AirPlay on macOS)
PORT=5001
NODE_ENV=development

# Groq (free tier) for live extraction: https://console.groq.com
# Leave empty to run without a key (tests use a fake client).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
